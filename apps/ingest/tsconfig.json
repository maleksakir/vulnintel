{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types/2023-07-01"],
    "paths": {
      "@threat-lens/contracts": ["../../packages/contracts/src/index.ts"],
      "@threat-lens/contracts/*": ["../../packages/contracts/src/*.ts"]
