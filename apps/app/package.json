{
  "name": "threat-lens-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types --env-interface CloudflareEnv",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^4.20250522.0",
    "@sveltejs/adapter-cloudflare": "^5.0.1",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.30.0",
    "svelte-check": "^4.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.14.4"
  },
  "dependencies": {
    "@tanstack/svelte-table": "9.3.1",
    "@tanstack/svelte-virtual": "3.13.48",
    "@threat-lens/contracts": "workspace:*",
    "bits-ui": "^2.20.2"
  }
}
