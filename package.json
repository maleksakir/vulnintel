{
  "name": "threat-lens-cve-hub",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "pnpm --filter=threat-lens-app build",
    "build:app": "pnpm --filter=threat-lens-app build",
    "check": "pnpm -r check",
    "check:app": "pnpm --filter=threat-lens-app check",
    "check:ingest": "pnpm --filter=@threat-lens/ingest check",
    "check:contracts": "pnpm --filter=@threat-lens/contracts check",
    "deploy:app": "pnpm --filter=threat-lens-app deploy",
    "deploy:app:staging": "pnpm --filter=threat-lens-app deploy:staging",
    "deploy:ingest": "pnpm --filter=@threat-lens/ingest deploy:prod",
    "deploy:ingest:staging": "pnpm --filter=@threat-lens/ingest deploy",
    "deploy:staging": "pnpm --filter=threat-lens-app deploy:staging && pnpm --filter=@threat-lens/ingest deploy",
    "types:app": "pnpm --filter=threat-lens-app types",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "^5.8.3"
  }
}
